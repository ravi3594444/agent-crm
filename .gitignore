
# secrets — every variant, including backups
.env
.env.*
!.env.example

# worktrees temporales de las herramientas de revisión
.claude/worktrees/

# logs de verificaciones corridas a mano
*.log
__pycache__/

# Dashboard static export and local execution state
/dist/
/node_modules/
/.openai/*.local.json

# El volcado de Redis. `pytest` necesita un Redis Stack de verdad —app/graph.py
# arma el checkpointer al importar— y ese servidor deja su `dump.rdb` en el
# directorio desde el que se lo levantó. Es estado local de una corrida, no del
# proyecto: sin esto, todo el que siga las instrucciones de CLAUDE.md se
# encuentra un binario sin trackear en `git status`.
dump.rdb
