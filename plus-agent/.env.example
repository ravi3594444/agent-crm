# plus-agent — configuración
#
#   cp .env.example .env    y completá lo que falta.
#
# Todo lo marcado OBLIGATORIO se lee en el arranque: si falta una, el
# contenedor no levanta (a propósito — es mejor que fallar en el primer
# mensaje de un cliente).
#
# Para verificar que está todo:  make check-env

# ---------------------------------------------------------------------------
# ERPNext — DOS pares de credenciales, y la diferencia importa
# ---------------------------------------------------------------------------
# URL interna del backend en la red de Docker (no la pública).
ERPNEXT_URL=http://backend:8000

# 1) El usuario del AGENTE. Rol "Agente IA": Create + Read en Item, Bin,
#    Customer, Lead, Sales Order, ToDo, Sales Invoice, Stock Reconciliation,
#    Delivery Note. **SIN permiso de Submit.** Este es el que toca el LLM.
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=

# 2) El usuario de la POLÍTICA. Rol con Submit sobre Sales Order y nada más.
#    NO es importable como herramienta del agente: solo lo usan app/policy.py
#    (vía app/tools/pedidos.py) y app/aprobacion.py, después de que pasan
#    todas las reglas deterministas o de que un humano toca el botón.
#    Si estas dos credenciales son las mismas que las de arriba, el guardarraíl
#    principal del sistema deja de existir.
ERPNEXT_POLICY_API_KEY=
ERPNEXT_POLICY_API_SECRET=

# Fijalas si tenés más de una compañía o más de un depósito: si no, el código
# toma la primera por orden alfabético y avisa por log.
ERPNEXT_COMPANY=
ERPNEXT_WAREHOUSE=

# Solo si vas a registrar ventas de mostrador como POS. Sin esto, las ventas
# offline se cargan como factura normal (más seguro: is_pos sin perfil hace
# fallar el Submit).
ERPNEXT_POS_PROFILE=

# ---------------------------------------------------------------------------
# WhatsApp / Meta — OBLIGATORIAS
# ---------------------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
# App Secret de la app de Meta: con esto se valida la firma del webhook.
META_APP_SECRET=
# Lo inventás vos; lo pegás igual en la config del webhook en Meta.
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0

# ---------------------------------------------------------------------------
# Redis — OBLIGATORIA
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# El negocio
# ---------------------------------------------------------------------------
NOMBRE_NEGOCIO=Lácteos Plus
HORARIO_ATENCION=lunes a viernes de 8 a 17

# Teléfonos del dueño y del equipo, separados por coma. Cualquier formato:
# se normalizan (ver app/telefono.py). EL PRIMERO es el que recibe las
# notificaciones cuando NOTIFICAR_SOLO_PRIMERO=true.
# Estos teléfonos entran al agente de GESTIÓN, con lectura de todo el negocio.
TELEFONOS_EQUIPO=+5493511111111
NOTIFICAR_SOLO_PRIMERO=true

# ---------------------------------------------------------------------------
# Stock — arrancá en false
# ---------------------------------------------------------------------------
# false = el bot toma pedidos pero NUNCA promete disponibilidad.
# Pasalo a true solo cuando el conteo de las 07:15 sea un hábito real.
STOCK_CONFIABLE=false
# Colchón que absorbe las ventas offline todavía no cargadas.
STOCK_BUFFER_PCT=20
# Debajo de esta cantidad el nivel es "POCO STOCK".
STOCK_POCO=20

# ---------------------------------------------------------------------------
# Auto-confirmación — arrancá en 0
# ---------------------------------------------------------------------------
# 0 = apagada: TODO pedido espera el OK del dueño. Es el estado de
# lanzamiento. Subilo de a poco mirando las decisiones en el log
# (`docker compose logs -f agente | grep policy`).
AUTO_CONFIRM_MAX=0
# Múltiplo del promedio histórico del cliente que se tolera.
AUTO_CONFIRM_MULT=2.0
# Pedidos confirmados que el cliente tiene que tener para calificar.
AUTO_CONFIRM_MIN_ORDERS=3
# Deuda vencida tolerada.
AUTO_CONFIRM_MAX_DEBT=0
# Días de entrega hacia adelante que se aceptan.
AUTO_CONFIRM_MAX_DIAS=30

# ---------------------------------------------------------------------------
# Modelos
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
LLM_MODEL_CLIENTES=anthropic:claude-haiku-4-5
LLM_MODEL_GERENCIA=anthropic:claude-sonnet-4-5
# Techo de pasos del agente por mensaje: protege el costo y el tiempo.
AGENTE_MAX_PASOS=12

# ---------------------------------------------------------------------------
# Operación
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
# Cuánto se reserva un message_id mientras se procesa. Tiene que ser mayor
# que el peor caso de procesamiento.
IDEMPOTENCIA_TTL_PROCESANDO=600
IDEMPOTENCIA_TTL_LISTO=86400
ERPNEXT_TIMEOUT=20
WHATSAPP_TIMEOUT=15
WHATSAPP_RETRIES=2
LOCK_TTL_SEGUNDOS=30
LOCK_ESPERA_SEGUNDOS=5
PAIS_TELEFONO=54
