# ERPNext customer-agent credentials (draft creation; never grant Submit).
ERPNEXT_URL=http://backend:8000
ERPNEXT_API_KEY=replace-me
ERPNEXT_API_SECRET=replace-me

# Management-agent credentials (broad read plus draft offline capture; no Submit).
ERPNEXT_MANAGER_API_KEY=replace-me
ERPNEXT_MANAGER_API_SECRET=replace-me

# Deterministic policy credentials. Keep these separate from the LLM-facing user.
ERPNEXT_POLICY_API_KEY=replace-me
ERPNEXT_POLICY_API_SECRET=replace-me

# Exact ERPNext names. The warehouse must be enabled, non-group, and belong to
# the configured company.
ERPNEXT_COMPANY=Plus Dairy
ERPNEXT_WAREHOUSE=Finished Goods - PD

# Redis Stack is required because LangGraph uses RediSearch indexes.
REDIS_URL=redis://redis-stack:6379/0
CONVERSATION_TTL_DAYS=30
# Non-system messages the model sees per turn (the checkpoint keeps everything).
CONVERSATION_MAX_MESSAGES=40

# The default models use LangChain's Google GenAI provider.
GOOGLE_API_KEY=replace-me
LLM_MODEL_CLIENTES=google_genai:gemini-2.5-flash
LLM_MODEL_GERENCIA=google_genai:gemini-2.5-pro

# Meta WhatsApp Cloud API. Use a System User token in production; never commit
# a temporary dashboard token or a real secret to this file. A temporary token
# from the Getting Started page dies within 24 h and the agent then logs
# "[whatsapp] ERROR Meta rechazó WHATSAPP_TOKEN" at startup.
META_APP_SECRET=replace-me
META_VERIFY_TOKEN=replace-with-a-long-random-value
WHATSAPP_PHONE_NUMBER_ID=replace-me
WHATSAPP_TOKEN=replace-me
# Graph API versions are retired ~2 years after release; bump here, no code change.
META_GRAPH_API_VERSION=v21.0
# Approved templates. Leave empty until Meta approves them: alerts then go out
# free-form ONLY to recipients who wrote to the bot in the last 24 h.
WHATSAPP_TEMPLATE_LANGUAGE=es_AR
WHATSAPP_STAFF_PENDING_TEMPLATE=
WHATSAPP_STAFF_CONFIRMED_TEMPLATE=
WHATSAPP_CUSTOMER_CONFIRMED_TEMPLATE=
# Permanent Meta rejections (token 190, recipient not allowed, closed window,
# template errors) are parked in the wa:{inbound}:dead Redis list at once.
# Timeouts, 429 and 5xx retry with exponential backoff (2 s doubling up to
# WHATSAPP_RETRY_MAX_SECONDS) at most WHATSAPP_SEND_MAX_ATTEMPTS times.
WHATSAPP_SEND_MAX_ATTEMPTS=10
WHATSAPP_RETRY_MAX_SECONDS=60

# Customer-facing business settings. Use an IANA timezone name.
NOMBRE_NEGOCIO=Plus Dairy
HORARIO_ATENCION=lunes a viernes de 8 a 17
BUSINESS_TIMEZONE=America/Argentina/Buenos_Aires
# Owner/staff numbers, comma separated, international format without "+".
# A number listed here is ALWAYS routed to the management agent, so it must be
# different from any phone used to test as a customer. Empty = no manager loop.
TELEFONOS_EQUIPO=5491100000000

# Start conservatively for a client deployment.
AUTO_CONFIRM_MAX=0
AUTO_CONFIRM_MULT=2.0
AUTO_CONFIRM_MIN_ORDERS=3
AUTO_CONFIRM_MAX_DEBT=0
AUTO_CONFIRM_PRICE_LIST=Standard Selling
AUTO_CONFIRM_CURRENCY=ARS
STOCK_CONFIABLE=false
STOCK_BUFFER_PCT=20
STOCK_POCO=20
NOTIFICAR_SOLO_PRIMERO=true
