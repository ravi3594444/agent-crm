{
  "name": "plus-agent",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": false
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "forwardPorts": [8080, 8081],
  "portsAttributes": {
    "8080": {
      "label": "ERPNext",
      "onAutoForward": "silent"
    },
    "8081": {
      "label": "agente (webhook de Meta)",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "cd plus-agent && python -m venv .venv && .venv/bin/pip install -q -r requirements-dev.txt",
  "postStartCommand": "nohup bash /workspaces/agent-crm/start.sh > /tmp/start.log 2>&1 &",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/plus-agent/.venv/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.cwd": "${containerWorkspaceFolder}/plus-agent",
        "python.testing.pytestArgs": ["tests"]
      }
    }
  }
}